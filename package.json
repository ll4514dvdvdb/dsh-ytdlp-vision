{
  "name": "ytdlp-vision",
  "version": "0.7.0",
  "description": "DSH 多平台视频证据插件：B 站走官方 API，其余站点交给 yt-dlp（1800+ 平台），也能直接读本机视频文件；支持播放列表/合集批量；带时间戳画面、字幕/ASR 与 OCR 原生返回当前视觉模型，按需细看、缓存和可选独立 API；启动时自动更新 yt-dlp；自带 cookie 配置页面",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "author": "icyaaaww",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ll4514dvdvdb/dsh-ytdlp-vision.git"
  },
  "homepage": "https://github.com/ll4514dvdvdb/dsh-ytdlp-vision#readme",
  "bugs": {
    "url": "https://github.com/ll4514dvdvdb/dsh-ytdlp-vision/issues"
  },
  "files": [
    "index.js",
    "client.js",
    "vision.py",
    "sources.py",
    "cookies.py",
    "update.py",
    "panel/*.js",
    "web/*",
    "cordis.patch.yml",
    "README.md",
    "requirements.txt",
    "smoke.mjs",
    "scripts/*.py",
    "vendor/yt-dlp-py.zip",
    "vendor/VERSION.json",
    "vendor/yt-dlp-public.key",
    "tests/*.py",
    "tests/*.mjs",
    "locale/*.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "youtube",
    "yt-dlp",
    "video-understanding",
    "whisper",
    "ocr"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test tests/plugin.test.mjs tests/host.test.mjs tests/sites.test.mjs tests/store.test.mjs",
    "test:node": "node --test tests/plugin.test.mjs tests/host.test.mjs tests/sites.test.mjs tests/store.test.mjs",
    "test:python": "python -B -m unittest discover -s tests -p test_*.py -v",
    "lint": "eslint .",
    "lint:py": "ruff check .",
    "check:release": "python -B scripts/check-release.py",
    "smoke": "node smoke.mjs",
    "update-ytdlp": "python scripts/fetch-ytdlp.py"
  }
}
